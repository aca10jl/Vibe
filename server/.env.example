# 复制为 .env 并按需填写（前端默认本地推理，无需任何配置即可 Demo）

# —— 模式一：Claude 在线 ——（前端切到“Claude 在线”时使用）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8

# —— 模式二：本地部署大模型 ——（前端切到“本地大模型”时使用，OpenAI 兼容端点）
# 也可不在此配置，改为在前端右上角 ⚙ 中设置 Base URL / 模型名
# Ollama:    http://localhost:11434/v1   （模型如 qwen2.5:7b-instruct、llama3.1:8b）
# LM Studio: http://localhost:1234/v1
# vLLM:      http://localhost:8000/v1
# llama.cpp: http://localhost:8080/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_API_KEY=

PORT=8787
